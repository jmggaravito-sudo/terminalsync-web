# Copy this to .env.local and fill in real values.
# NEVER commit .env.local — it's in .gitignore.

# ── Stripe ──────────────────────────────────────────────────────────────
# Use test keys (sk_test_*, whsec_*) during development.
# Swap to live keys only when deploying to production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Create the recurring products in your Stripe dashboard. Each plan has
# BOTH a monthly and a yearly price (yearly = 12mo × monthly × 0.83 to
# match the "save 17%" badge on the landing). Agency is a single
# annual-only lead-gen plan, not a self-serve Stripe price the checkout
# uses today — the env still gets read by some legacy components, so
# leave it set even if it points at a placeholder.
#   Pro Monthly — $19/mo
#   Pro Yearly  — $190/yr  (≈ $15.83/mo billed annually)
#   Dev Monthly — $39/mo
#   Dev Yearly  — $390/yr  (≈ $32.50/mo billed annually)
#   Agency      — $49/mo (legacy / lead-gen only)
STRIPE_PRICE_PRO_MONTHLY=price_xxx_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_xxx_pro_yearly
STRIPE_PRICE_DEV_MONTHLY=price_xxx_dev_monthly
STRIPE_PRICE_DEV_YEARLY=price_xxx_dev_yearly
STRIPE_PRICE_AGENCY=price_xxx_agency_monthly

# Public: used in browser — must be the publishable key (pk_*), NOT secret.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Mercado Pago + prepaid AI credits ────────────────────────────────
# One-time COP credit checkouts use Checkout Pro preferences. The webhook
# secret is mandatory before credit payment notifications are accepted.
MERCADOPAGO_ACCESS_TOKEN=APP_USR_xxx
MERCADOPAGO_WEBHOOK_SECRET=xxx
MERCADOPAGO_CURRENCY=COP

# AI credit checkout is fail-closed while desktop consumption is still local.
# For a Lab smoke, enable the global gate and list only verified Supabase user
# UUIDs. Keep stable disabled until cloud status/debit/refund is authoritative.
AI_CREDITS_CHECKOUT_ENABLED=0
AI_CREDITS_CHECKOUT_LAB_USER_IDS=
AI_CREDITS_CHECKOUT_STABLE_ENABLED=0

# ── Site ────────────────────────────────────────────────────────────────
# Used to build absolute URLs (success/cancel redirects, webhooks).
# In Vercel this is set automatically via VERCEL_URL, but define it in
# .env.local for consistent local testing:
NEXT_PUBLIC_SITE_URL=http://localhost:3131

# ── Rewardful (programa de afiliados) ───────────────────────────────────
# Setup:
#   1. Crear cuenta en https://www.rewardful.com (free trial 14 días)
#   2. Settings → API Keys → copiar la "Public API Key" abajo
#   3. Settings → Stripe → conectar tu cuenta Stripe (live + test)
#   4. Affiliates → Signup Page → copiar la URL pública abajo
#
# El script de tracking se carga automáticamente cuando esta var está set.
# Si está vacía, todo el flujo de afiliados queda dormido y no se inyecta
# nada en el HTML — perfecto para entornos sin Rewardful.
NEXT_PUBLIC_REWARDFUL_API_KEY=
NEXT_PUBLIC_REWARDFUL_SIGNUP_URL=

# ── Marketplace (Stripe Connect Express) ────────────────────────────────
# Setup:
#   1. Stripe Dashboard → Connect → Get Started (Express).
#   2. Copy the Connect "client_id" (ca_*) here. Used when creating
#      account links. Server-only, no NEXT_PUBLIC_ prefix.
#   3. Enable these webhook events on your Stripe webhook endpoint
#      (in addition to the subscription events already wired):
#        - account.updated
#        - transfer.created
#        - checkout.session.completed (already enabled)
#   4. Apply the SQL migration: supabase/migrations/0001_marketplace.sql.
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# Comma-separated list of admin emails (lowercase). These accounts can
# approve/reject marketplace listings via PATCH /api/marketplace/listings/[id].
# Empty = no admins, which means no listings get approved. Set this before
# launching the marketplace.
ADMIN_EMAILS=jm@terminalsync.ai

# Service-role key for server-side Supabase ops. Already required by the
# Stripe webhook; the marketplace API routes use the same admin client.
# SUPABASE_URL must be the bare project origin — https://<ref>.supabase.co —
# with NO trailing path (not /rest/v1). A path suffix breaks Auth.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser (anon) Supabase client — magic-link + Google OAuth login.
# Same rule as above: bare origin only, no /rest/v1 or trailing slash.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kill switch — when "true", first-time visitors hitting /[lang]/login are
# redirected to /[lang]/at-capacity instead. Existing users with a Supabase
# auth cookie are unaffected. Toggle without redeploy via Vercel env vars.
NEW_SIGNUPS_DISABLED=false

# Community invite (Discord/Slack) shown on /[lang]/gracias. Hidden if unset.
NEXT_PUBLIC_COMMUNITY_INVITE_URL=

# 60s "next steps" video shown on /[lang]/gracias. Loom or YouTube embed URL.
# Falls back to a styled placeholder when unset.
NEXT_PUBLIC_NEXT_STEPS_VIDEO_URL=

# n8n webhook for the welcome email flow (workflow 9sMs1ExYtue9ay1n).
# Server-only — never expose. /api/welcome-trigger is the call site.
WELCOME_FLOW_WEBHOOK_URL=https://n8n.nexflowai.net/webhook/tsync-welcome

# Shared secret between /api/welcome-trigger and the n8n welcome workflow.
# The workflow's first node rejects calls whose X-Welcome-Secret header
# doesn't match this value. Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WELCOME_FLOW_SECRET=

# n8n public API key — read by /api/admin/launch-metrics to count
# executions of the welcome flow + replies workflows. Read-only on n8n.
N8N_API_KEY=

# n8n webhook called by /api/outreach/update when JM marks an influencer
# as "respondió". n8n should upsert the GHL contact, move/create the
# opportunity in the influencer pipeline, notify Telegram, and prepare
# the AI response analysis. Leave empty until that workflow is live.
OUTREACH_REPLY_WEBHOOK_URL=

# Server-side only. Matched against X-API-Key on POST /api/business-leads/ingest
# — the n8n "TS - Business Leads (Google Maps)" workflow uses it to push
# scraped local businesses (dental clinics, schools, NGOs, service businesses)
# into the business_leads table for the /admin/business-leads queue.
BUSINESS_LEADS_INGEST_KEY=

# Public — inlined into the client bundle. E.164 digits only (no "+", no
# spaces), e.g. 17542760917. Powers the floating WhatsApp button on the
# public landing (src/components/landing/WhatsAppFloatingButton.tsx).
# Deliberately a SEPARATE Kapso number from the one behind TSync Bridge
# (that one is wired 1:1 to JM's own session-control pipeline — routing
# public visitor messages into it would mix strangers into that channel).
# Leave empty to hide the button; nothing else depends on this var.
NEXT_PUBLIC_CONTACT_WHATSAPP_NUMBER=

# ── Connector Loop run history ─────────────────────────────────────────
# Server-side only. Used by POST /api/internal/loop-runs to authenticate the
# manual connectors Loop when it records a completed run. Store the same value
# in Vercel env vars and in the environment that runs the Loop; never commit
# the real token. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LOOP_RUNS_WRITE_TOKEN=

# Optional when running scripts/auto_promote_connectors.mjs outside Vercel.
# Defaults to NEXT_PUBLIC_SITE_URL + /api/internal/loop-runs when available.
LOOP_RUNS_ENDPOINT=

# Optional: set this to the PR URL opened by the manual Loop before the script
# records the run. Kept out of repo; pass via shell/env at run time.
LOOP_RUNS_PR_URL=

# ── Integraciones admin: paridad 4 IAs (/admin/integraciones) ───────────
# Server-side only. Powers "Correr ahora" on /admin/integraciones: dispatches
# and polls the `connector-loop.yml` GitHub Actions workflow in the
# `terminal-sync` repo (multi-AI connector-parity supervisor — Claude, Codex,
# Gemini, GLM).
#
# IMPORTANT: this needs a fine-grained GitHub token scoped
# Contents: Read + Actions: Read+Write on jmggaravito-sudo/terminal-sync.
# The existing OPS_GITHUB_TOKEN (used by /admin/ops/reports, see
# src/lib/ops/reports.ts) is Actions: Read ONLY — it can list runs but cannot
# dispatch one. Either create a new fine-grained token with the Write scope
# and set it here, or upgrade OPS_GITHUB_TOKEN's scope on GitHub and leave
# this var empty (the route falls back to OPS_GITHUB_TOKEN when unset).
INTEGRATIONS_GH_TOKEN=

# ── Leads LinkedIn (admin) ──────────────────────────────────────────────
# Server-side only. Powers /admin/leads-linkedin: Apify searches public
# LinkedIn profiles, Anthropic drafts the per-lead outreach message.
# APIFY_TOKEN      — Apify Console → Settings → Integrations → Personal API tokens.
APIFY_TOKEN=
# Defaults to harvestapi/linkedin-profile-search if unset (no login/cookies
# required). Verify the actor id is still valid in Apify Store before relying on it.
APIFY_LINKEDIN_ACTOR_ID=
# console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=

# ── Investigar candidato con IA (/admin/integraciones, Panel B) ─────────
# Server-side only. El botón "Investigar y pre-llenar con IA" llama al
# modelo con búsqueda web para armar la ficha del candidato.
#
# La key elegida decide el endpoint. Hay dos caminos y no se mezclan:
#
#   A) Anthropic — basta con ANTHROPIC_API_KEY (más abajo, sección de Leads
#      LinkedIn). Endpoint de Anthropic, modelo claude-opus-5, búsqueda web
#      encendida. No hace falta nada de esta sección.
#
#   B) Z.ai/GLM — ZAI_API_KEY (o Z_AI_API_KEY: el secret de GitHub se llama
#      con guiones bajos y los workflows lo leen sin ellos, así que se
#      aceptan los dos) MÁS CANDIDATE_SUGGEST_MODEL. La key de Z.ai gana
#      sobre la de Anthropic si están las dos.
#
# Endpoint compatible con Anthropic de Z.ai. Por defecto
# https://open.bigmodel.cn/api/anthropic — ojo que NO es /api/paas/v4, que
# es la URL de PaaS y no habla el protocolo de Anthropic. Solo hace falta
# si usás otro host (p. ej. https://api.z.ai/api/anthropic).
CANDIDATE_SUGGEST_BASE_URL=
# Con Anthropic: default claude-opus-5. Con Z.ai: OBLIGATORIA — sirve
# modelos GLM, no Claude, y los ids cambian entre versiones. Los listás con:
#   curl https://open.bigmodel.cn/api/paas/v4/models -H "Authorization: Bearer <key>"
CANDIDATE_SUGGEST_MODEL=
# La búsqueda web es una server tool de Anthropic: con Z.ai se apaga sola.
# "on" la fuerza, "off" la apaga en Anthropic.
CANDIDATE_SUGGEST_WEB_SEARCH=

# ── Admin AI Center (/admin/ai-center) ──────────────────────────────────
# Live source for the admin-only AI Control Center mirror: GitHub Contents
# API URL pointing at the orphan `ai-center-snapshot` branch of the app repo
# (the branch the TerminalSync desktop app's Rust exporter publishes its
# camelCase AiControlCenterSnapshot JSON to). When unset, the route falls
# back to the hardcoded mirror in src/lib/adminAiCenter.ts.
TERMINALSYNC_AI_CENTER_URL=
# Token for the GitHub Contents API call above (required whenever the URL
# points at api.github.com — falls back to OPS_GITHUB_TOKEN if unset).
TERMINALSYNC_AI_CENTER_TOKEN=
# Fetch timeout in ms before falling back to the local mirror. Default 5000.
TERMINALSYNC_AI_CENTER_TIMEOUT_MS=

# ── Corregir loop (/admin/soporte/correcciones, POST /api/admin/soporte/corrections) ──
# Server-side only, NEVER sent to the client. Powers the "Corregir" button:
# turns a JM-written correction into a draft PR against
# jmggaravito-sudo/terminal-sync (branch off release/v0.2.18-lab, edits
# docs/sync-bot-knowledge.md).
#
# Needs a fine-grained GitHub PAT scoped to ONLY jmggaravito-sudo/terminal-sync:
#   - Contents: Read and write   (create the branch, edit the file)
#   - Pull requests: Read and write   (open the draft PR)
# Without this set, the route responds 503 and the correction stays saved in
# Supabase with status "error" — nothing is lost, it's just not opened as a
# PR until the token is configured.
TS_CORRECTIONS_GITHUB_TOKEN=

# ── Sentry (error monitoring) ────────────────────────────────────────────
# Read by instrumentation.ts (server/edge) and src/instrumentation-client.ts
# (browser) — both no-op when unset, so the site keeps working without it.
# MUST be a single line: pasting this into Vercel with a line break in the
# middle of the value produces an invalid DSN and Sentry.init() throws,
# which is exactly the bug that broke error reporting in production.
NEXT_PUBLIC_SENTRY_DSN=https://b85f163acc60db0481f6092672e530a1@o4511337448210432.ingest.us.sentry.io/4511337773858816
